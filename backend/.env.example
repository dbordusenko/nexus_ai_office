GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Auth (optional — auto-generated if omitted)
# AUTH_SECRET=your-long-random-string

# Email sending for "Share via Email" (optional).
# If omitted, a test Ethereal account is used (emails go to a preview URL,
# not real inboxes). For real delivery, fill these in.
# Gmail example: create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=FlyPDF <you@gmail.com>

# Billing (Stripe) — for the 7-day trial + $5/mo subscription
# Get keys at https://dashboard.stripe.com/apikeys (use test keys first)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...           # a $5/month recurring Price
# STRIPE_WEBHOOK_SECRET=whsec_...     # from the webhook endpoint you create
# TRIAL_DAYS=7
# APP_URL=https://192.18.131.82.sslip.io
